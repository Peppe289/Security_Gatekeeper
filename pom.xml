<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>io.github.peppe289</groupId>
    <artifactId>security_gatekeeper</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>security_gatekeeper</name>
    <description>Containerized HTTP reverse proxy with a web admin panel, per-route rate limiting, API keys and a tamper-evident audit chain</description>

    <properties>
        <java.version>25</java.version>

        <!-- Quality tooling -->
        <jacoco.version>0.8.16</jacoco.version>
        <!-- Coverage gates: strict on the pure-Java domain, looser on the whole project -->
        <jacoco.core.minimum.line.coverage>0.95</jacoco.core.minimum.line.coverage>
        <jacoco.core.minimum.branch.coverage>0.95</jacoco.core.minimum.branch.coverage>
        <jacoco.project.minimum.line.coverage>0.85</jacoco.project.minimum.line.coverage>
        <jacoco.project.minimum.branch.coverage>0.80</jacoco.project.minimum.branch.coverage>
        <pitest.version>1.30.2</pitest.version>
        <pitest.junit5.version>1.2.3</pitest.junit5.version>
        <pitest.mutation.threshold>90</pitest.mutation.threshold>
        <!-- Line coverage of the mutated classes, as measured by PiTest -->
        <pitest.coverage.threshold>95</pitest.coverage.threshold>
        <jmh.version>1.37</jmh.version>
        <exec-maven-plugin.version>3.7.0</exec-maven-plugin.version>

        <!-- Test stack required by the course: newer than the versions managed by Spring Boot -->
        <junit-jupiter.version>6.1.3</junit-jupiter.version>
        <mockito.version>5.24.0</mockito.version>
        <!-- Set by JaCoCo's prepare-agent; empty when it does not run -->
        <argLine></argLine>
    </properties>

    <dependencies>
        <!-- Versions are managed by spring-boot-starter-parent: never pin starters individually -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Persistence: plain JDBC + Flyway migrations on PostgreSQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JMH: test scope only, never shipped in the runtime jar / Docker image -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- JMH annotation processor runs only when compiling tests (benchmarks live in src/test/java) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                    <version>${jmh.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Exposes the path of the Mockito jar as ${org.mockito:mockito-core:jar} -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dependency-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Mockito's inline mock maker is loaded as an agent: the JDK warns about (and will
                 eventually forbid) agents attached at run time -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>

            <!-- JaCoCo: coverage report + quality gate bound to `mvn verify` -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <!-- Spring Boot bootstrap and JMH generated code carry no logic -->
                        <exclude>io/github/peppe289/security_gatekeeper/SecurityGatekeeperApplication.class</exclude>
                        <exclude>**/jmh_generated/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-core</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- Pure-Java domain: no framework, every path must be tested. -->
                            <includes>
                                <include>io/github/peppe289/security_gatekeeper/core/**</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.core.minimum.line.coverage}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.core.minimum.branch.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-project</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- Whole project, unit and integration tests together. -->
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.project.minimum.line.coverage}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.project.minimum.branch.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- PiTest: run with `mvn test-compile org.pitest:pitest-maven:mutationCoverage` (or -Pmutation verify) -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest.junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>io.github.peppe289.security_gatekeeper.core.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>io.github.peppe289.security_gatekeeper.core.*</param>
                    </targetTests>
                    <excludedTestClasses>
                        <param>io.github.peppe289.security_gatekeeper.benchmark.*</param>
                    </excludedTestClasses>
                    <mutators>
                        <mutator>STRONGER</mutator>
                    </mutators>
                    <mutationThreshold>${pitest.mutation.threshold}</mutationThreshold>
                    <coverageThreshold>${pitest.coverage.threshold}</coverageThreshold>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- `mvn -Pmutation verify`: also enforces the PiTest mutation threshold -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <executions>
                            <execution>
                                <id>pitest</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- `mvn -Prac -Dopenjml.home=<OpenJML dir> test`: runtime assertion checking. Runs the core
             unit tests against the classes compiled by `openjml -rac` (specs path src/main/jml,
             output target/rac) instead of target/classes, so
             every call made by the tests also checks the JML contracts. OpenJML reports each
             violation as a "verify: JML ..." line on the console; openjml.yml gates on them. -->
        <profile>
            <id>rac</id>
            <properties>
                <jacoco.skip>true</jacoco.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <classesDirectory>${project.build.directory}/rac</classesDirectory>
                            <!-- jmlruntime.jar, plus org.jmlspecs.lang (JML's bigint/real types), which
                                 OpenJML ships inside the java.base module of its own JDK 21: extracted
                                 into target/rac-lib/jml-lang.jar so the tests can run on JDK 25. -->
                            <additionalClasspathElements>
                                <additionalClasspathElement>${openjml.home}/jmlruntime.jar</additionalClasspathElement>
                                <additionalClasspathElement>${project.build.directory}/rac-lib/jml-lang.jar</additionalClasspathElement>
                            </additionalClasspathElements>
                            <includes>
                                <include>**/core/**/*Test.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- `mvn -Pmutation-all test-compile org.pitest:pitest-maven:mutationCoverage`: mutation
             campaign on the whole project, for analysis only (no threshold). Unit tests only:
             integration tests would start PostgreSQL for every mutant. Report in
             target/pit-reports-all. -->
        <profile>
            <id>mutation-all</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses combine.self="override">
                                <param>io.github.peppe289.security_gatekeeper.*</param>
                            </targetClasses>
                            <targetTests combine.self="override">
                                <param>io.github.peppe289.security_gatekeeper.*</param>
                            </targetTests>
                            <excludedClasses>
                                <param>io.github.peppe289.security_gatekeeper.SecurityGatekeeperApplication</param>
                            </excludedClasses>
                            <excludedTestClasses combine.self="override">
                                <param>io.github.peppe289.security_gatekeeper.benchmark.*</param>
                                <param>*IntegrationTest</param>
                            </excludedTestClasses>
                            <mutationThreshold combine.self="override">0</mutationThreshold>
                            <coverageThreshold combine.self="override">0</coverageThreshold>
                            <threads>4</threads>
                            <reportsDirectory>${project.build.directory}/pit-reports-all</reportsDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- `mvn -Pbenchmark -DskipTests verify [-Djmh.args="TokenBucket -f 1"]`: runs JMH benchmarks -->
        <profile>
            <id>benchmark</id>
            <properties>
                <jmh.args>-rf json -rff target/jmh-result.json</jmh.args>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>run-jmh</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <classpathScope>test</classpathScope>
                                    <commandlineArgs>-cp %classpath org.openjdk.jmh.Main ${jmh.args}</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
